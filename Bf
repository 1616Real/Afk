-- ระบบการทำงาน AFK
local vu = game:GetService("VirtualUser")
local localPlayer = game:GetService("Players").LocalPlayer
local afkConnection = nil
local isRunning = false

local function startAFK()
	if isRunning then return end
	isRunning = true
	
	-- ป้องกันหน้าจอดับหรือถูกเตะเมื่อไม่ได้ขยับ
	localPlayer.Idled:Connect(function()
		if isRunning then
			vu:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
			task.wait(1)
			vu:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
		end
	end)

	-- ขยับมุมกล้องเล็กน้อยทุกๆ 3 นาที เพื่อรีเซ็ตสถานะ Idle ของเซิร์ฟเวอร์
	afkConnection = task.spawn(function()
		while isRunning do
			task.repeatWait = task.wait(180) -- ทุก 3 นาที
			local vim = game:GetService("VirtualInputManager")
			vim:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
			task.wait(0.2)
			vim:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
		end
	end)
	
	ToggleButton.Text = "ปิดใช้งาน AFK"
	ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
end

local function stopAFK()
	isRunning = false
	if afkConnection then
		task.cancel(afkConnection)
	end
	ToggleButton.Text = "เปิดใช้งาน AFK"
	ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 170, 127)
end

-- กดปุ่มเพื่อสลับการทำงาน
ToggleButton.MouseButton1Click:Connect(function()
	if not isRunning then
		startAFK()
	else
		stopAFK()
	end
end)
